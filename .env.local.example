# Copy this file to .env.local and fill in your Supabase project credentials.
# If these are left unset, MfgPlan automatically falls back to an in-memory
# mock data layer so the app is still fully browsable for a demo.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Name of the Supabase Storage bucket used for CAD file uploads
NEXT_PUBLIC_CAD_BUCKET=cad-files
